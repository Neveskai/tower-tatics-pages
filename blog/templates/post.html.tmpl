<article class="reading-page">
  <header class="article-heading"><p class="eyebrow">{{KICKER}}</p><h1 lang="pt-BR">{{TITLE}}</h1><div class="post-meta"><time datetime="{{ISO_DATE}}">{{DATE}}</time><span class="language-note">{{LANGUAGE_NOTE}}</span></div><p class="article-summary" lang="pt-BR">{{SUMMARY}}</p><div class="tags">{{TAGS}}</div></header>
  <div class="post-body" lang="pt-BR">{{CONTENT}}</div>
  <a class="back-link" href="../index.html">← {{BACK}}</a>
</article>
